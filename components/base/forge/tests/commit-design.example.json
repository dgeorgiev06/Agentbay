                  "answer": {
                    "id": 3,
                    "text": "post the letter",
                    "status": "open"
                  }
                }
              ]
            },
            {
              "name": "list",
              "request": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": ["open", "all"]
                  }
                }
              },
              "response": {
                "type": "object",
                "additionalProperties": false,
                "required": ["todos"],
                "properties": {
                  "todos": {
                    "type": "array",
                    "items": {
                      "$ref": "add-response.json"
                    }
                  }
                }
              },
              "serves": ["O1-C1", "O1-C2", "O1-C3", "O2-C1", "O2-C2", "O2-C3"],
              "reads": ["todos"],
              "examples": [
                {
                  "input": {},
                  "answer": {
                    "todos": []
                  }
                },
                {
                  "earlier": [
                    {
                      "action": "add",
                      "input": {
                        "text": "buy milk"
                      }
                    },
                    {
                      "action": "add",
                      "input": {
                        "text": "call the bank"
                      }
                    }
                  ],
                  "input": {
                    "status": "open"
                  },
                  "answer": {
                    "todos": [
                      {
                        "id": 1,
                        "text": "buy milk",
                        "status": "open"
