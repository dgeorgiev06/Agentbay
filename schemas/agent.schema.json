{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/v2/Agent",
  "title": "Agent",
  "description": "An agent profile: how one LLM product runs roles. It is the only concept that knows the product: the runtime per kind of role, the model for each tier, effort values and tool names. One file per product, selected once in agentbay.config.yaml (`agent:`, default claude-code).",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agentbay/v2"
    },
    "kind": {
      "const": "Agent"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "spec": {
      "oneOf": [
        {
          "$ref": "#/$defs/profile"
        },
        {
          "$ref": "#/$defs/legacy"
        }
      ]
    }
  },
  "$defs": {
    "runtime": {
      "enum": [
        "claude-code-main",
        "claude-code-subagent",
        "headless",
        "cloud"
      ]
    },
    "profile": {
      "type": "object",
      "required": [
        "runtime",
        "tiers"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "object",
          "required": [
            "coordinator",
            "worker"
          ],
          "additionalProperties": false,
          "description": "Runtime per kind of role. coordinator: a mode's coordinator role (claude-code-main runs it as a playbook in the Chief of Staff's main thread); worker: every other role (claude-code-subagent: a generated .claude/agents/<role>--<mode>.md).",
          "properties": {
            "coordinator": {
              "$ref": "#/$defs/runtime"
            },
            "worker": {
              "$ref": "#/$defs/runtime"
            }
          }
        },
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "description": "The product's model for each tier.",
          "properties": {
            "fast": {
              "type": "string",
              "minLength": 1
            },
            "balanced": {
              "type": "string",
              "minLength": 1
            },
            "deep": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "fast",
            "balanced",
            "deep"
          ]
        },
        "effort": {
          "type": "object",
          "additionalProperties": false,
          "description": "The product's value for each effort (default: the same word).",
          "properties": {
            "low": {
              "type": "string",
              "minLength": 1
            },
            "medium": {
              "type": "string",
              "minLength": 1
            },
            "high": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Optional: agentbay tool name (as bound in envs) -> the product's tool name (default: the same name)."
        }
      }
    },
    "legacy": {
      "type": "object",
      "required": [
        "runtime",
        "model",
        "env"
      ],
      "additionalProperties": false,
      "deprecated": true,
      "description": "Deprecated (0.3) per-role agent in user space: its env goes into each using mode's `roles:`, its model becomes a tier. `bay migrate` folds it into the modes and deletes it.",
      "properties": {
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "model": {
          "enum": [
            "haiku",
            "sonnet",
            "opus",
            "inherit"
          ]
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "env": {
          "type": "string"
        }
      }
    }
  }
}
