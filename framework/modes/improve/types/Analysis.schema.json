{
  "description": "Triage analysis of the top findings: root cause, proposed (preferably preventive) fix, route and effort.",
  "type": "object",
  "required": [
    "annotations"
  ],
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rootCause",
          "proposedFix",
          "route",
          "effort",
          "evidenceChecked"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9a-f]{8}$"
          },
          "rootCause": {
            "type": "string",
            "minLength": 10,
            "maxLength": 800
          },
          "proposedFix": {
            "type": "string",
            "minLength": 10,
            "maxLength": 800
          },
          "route": {
            "enum": [
              "forge.extend",
              "mode-fix",
              "config",
              "none"
            ]
          },
          "effort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "evidenceChecked": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "the evidence refs the analyst confirmed"
          },
          "costEstimate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minutesPerWeek": {
                "type": "number"
              },
              "usdPerWeek": {
                "type": "number"
              },
              "tokensPerWeek": {
                "type": "number"
              },
              "note": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    }
  }
}
