{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontier",
  "description": "What the interviewer is given for one turn, read from the PM mode's records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["job", "turn", "perTurn", "asked", "questions", "asks", "lookUp"],
  "properties": {
    "job": {
      "type": "string"
    },
    "turn": {
      "type": "integer",
      "minimum": 1
    },
    "perTurn": {
      "type": "integer",
      "minimum": 1
    },
    "asked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["by", "on", "words"],
        "properties": {
          "by": {
            "type": "string"
          },
          "on": {
            "type": "string"
          },
          "words": {
            "type": "string"
          }
        }
      },
      "description": "Each time words were given for the work, by whom and when."
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A question, as schemas/question.json gives it."
      }
    },
    "asks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^Q[1-9][0-9]{0,3}$"
      },
      "description": "The questions this turn asks, in order."
    },
    "lookUp": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^Q[1-9][0-9]{0,3}$"
      },
      "description": "The facts this turn may look up."
    }
  }
}
