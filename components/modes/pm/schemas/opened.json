{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opened",
  "description": "The start card and what begin needs after the owner's choice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["job", "words", "by", "card", "offered"],
  "properties": {
    "job": {
      "type": "string",
      "description": "As schemas/open-request.json gives it."
    },
    "words": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "card": {
      "type": "object",
      "description": "The start card; the kernel checks it when it shows it."
    },
    "offered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": {
          "type": "boolean"
        }
      }
    }
  }
}
