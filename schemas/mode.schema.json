{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/v2/Mode",
  "title": "Mode",
  "description": "A job playbook: one logical job. Endpoints run workflows of code steps (run: <capability>/v<N>.<endpoint>) and agentic steps (role: <role>). Modes name capabilities, never concrete tools.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agentbay/v2"
    },
    "kind": {
      "const": "Mode"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$",
          "description": "Parent mode, resolved at build time: the child inherits endpoints, workflows, playbooks, rules, review settings, roles, constraints, inference, needs, config, types, skills and the coordinator playbook, and overrides any of them (endpoints merge key by key, workflows are replaced per workflow). Inheritance cycles and missing parents are errors."
        },
        "abstract": {
          "type": "boolean",
          "description": "A base for `extends` only: linted, never resolved, installed or called. Not inherited."
        },
        "purpose": {
          "type": "string"
        },
        "endpoints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "workflow",
              "effects"
            ],
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "workflow": {
                "type": "string"
              },
              "in": {
                "type": "string",
                "description": "Type name: modes/<mode>/types/<Name>.schema.json"
              },
              "out": {
                "type": "string"
              },
              "effects": {
                "type": "array",
                "items": {
                  "enum": [
                    "read",
                    "write",
                    "network",
                    "spend",
                    "delete"
                  ]
                },
                "uniqueItems": true,
                "description": "Everything this endpoint may do. Every step's effects must be declared here and allowed by the env."
              },
              "playbook": {
                "type": "string",
                "description": "features/<feature>/playbook.md (relative to the mode folder)"
              },
              "rules": {
                "type": "string",
                "description": "features/<feature>/rules.yaml"
              },
              "review": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "when"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "when": {
                    "enum": [
                      "always",
                      "never"
                    ]
                  },
                  "model": {
                    "enum": [
                      "haiku",
                      "sonnet",
                      "opus",
                      "inherit"
                    ]
                  },
                  "effort": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "rulesets": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "description": "Framework rule sets (framework/rules/<name>.yaml, e.g. conformance) added to the reviewer's plan next to the feature's DoD and rules."
                  }
                },
                "if": {
                  "properties": {
                    "when": {
                      "const": "always"
                    }
                  }
                },
                "then": {
                  "required": [
                    "role",
                    "when"
                  ]
                },
                "description": "Optional. The ONLY place review is configured. when: always injects a review step after the output step."
              },
              "schedule": {
                "type": "string"
              },
              "agents": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Per-endpoint placement: role -> agent override (e.g. builder: author)."
              }
            }
          }
        },
        "coordinator": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "workflows": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "run"
                  ]
                },
                {
                  "required": [
                    "role"
                  ]
                },
                {
                  "required": [
                    "gate"
                  ]
                },
                {
                  "required": [
                    "review"
                  ]
                }
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "run": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*/v[0-9]+\\.[a-z][a-z0-9-]*$",
                  "description": "Code step: <capability>/v<N>.<endpoint>, e.g. items.store/v1.sync (same spelling as role `uses`)."
                },
                "role": {
                  "type": "string"
                },
                "with": {
                  "type": "object",
                  "description": "Input for a code step. \"$in.<field>\" and \"$steps.<id>.<field>\" are substituted; missing values are dropped."
                },
                "when": {
                  "type": "string",
                  "pattern": "^(stale\\s*>\\s*[0-9]+[mhdw]|\\$in\\.[A-Za-z][A-Za-z0-9]*)$",
                  "description": "`stale > 2h` (skip unless the store is older) or `$in.<field>` (skip unless truthy)."
                },
                "task": {
                  "type": "string",
                  "description": "What the role should do in this step (goal of its TaskEnvelope)."
                },
                "out": {
                  "type": "string"
                },
                "gate": {
                  "type": "string",
                  "description": "Approval gate: the dispatcher stops with status awaiting-approval and shows this text; resume with `bay submit <callId> <stepId> '{\"approved\": true}'`."
                },
                "review": {
                  "const": "here",
                  "description": "Position marker for the review step configured on the endpoint (mode.yaml endpoints.<f>.review). Without a marker, review runs after the last step."
                }
              }
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "$ref": "#/$defs/inference"
            },
            "steps": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/inference"
              }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lookbackMax": {
              "type": "string",
              "pattern": "^[0-9]+[mhdw]$"
            },
            "spendUsd": {
              "type": "number",
              "minimum": 0
            },
            "monthlyItems": {
              "type": "integer",
              "minimum": 0,
              "description": "Items a source may read per UTC month."
            },
            "maxItemsPerRun": {
              "type": "integer",
              "minimum": 0,
              "description": "Items one sync may read."
            },
            "monthlyPosts": {
              "type": "integer",
              "minimum": 0,
              "deprecated": true,
              "description": "Deprecated (0.3) name of monthlyItems; `bay migrate` renames it."
            },
            "maxPostsPerRun": {
              "type": "integer",
              "minimum": 0,
              "deprecated": true,
              "description": "Deprecated (0.3) name of maxItemsPerRun; `bay migrate` renames it."
            },
            "policies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*/v[0-9]+$"
          }
        },
        "config": {
          "type": "string",
          "description": "JSON Schema file (in the mode folder) for agentbay.config.yaml modes.<name>."
        }
      },
      "if": {
        "not": {
          "required": [
            "extends"
          ]
        }
      },
      "then": {
        "required": [
          "purpose",
          "endpoints",
          "roles",
          "workflows"
        ]
      }
    }
  },
  "$defs": {
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "enum": [
            "haiku",
            "sonnet",
            "opus",
            "inherit"
          ]
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  }
}
