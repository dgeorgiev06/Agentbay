{
  "type": "object",
  "required": ["goal"],
  "additionalProperties": false,
  "properties": {
    "goal": { "type": "string", "minLength": 5 },
    "proposal": { "type": "string", "description": "Existing docs/proposals/<id>.md to implement" },
    "context": { "type": "string" },
    "replaces": {
      "type": "string",
      "pattern": "^C-[0-9]{8}-[0-9a-f]{6}$",
      "description": "supersedes a call: open ends abandoned, blocked/failed/partial stays; keeps its base commit"
    }
  }
}
