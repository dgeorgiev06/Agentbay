{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AllowanceRequest",
  "description": "The source to ask about.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source"
  ],
  "properties": {
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "The source's name, as its describe and its items give it."
    }
  }
}
