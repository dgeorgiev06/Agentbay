{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProveChecksRequest",
  "description": "What proof is to be asked for a head's checks and whole test run, as combine gives it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proving"],
  "properties": {
    "proving": {
      "type": "object",
      "description": "What proof is to be asked for the checks: not asked, or a request, the slices whose kept tests filter the answer, and the solo proofs to run when the checks fail.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "not asked"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "asked", "keptOf", "whenFailed"],
          "properties": {
            "kind": {
              "const": "asked"
            },
            "asked": {
              "$ref": "proof@1/prove-request.json"
            },
            "keptOf": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "$ref": "proof@1/prove-request.json#/$defs/sliceName"
              },
              "description": "The slices whose kept tests the answer is filtered against."
            },
            "whenFailed": {
              "type": "array",
              "maxItems": 50,
              "description": "The solo proofs to run when the checks fail, one for each slice in the combined head.",
              "items": {
                "type": "object"
              }
            },
            "trying": {
              "type": "object",
              "additionalProperties": false,
              "required": ["built", "slices"],
              "properties": {
                "built": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "string",
                    "maxLength": 81
                  },
                  "description": "The design's actions the combined head builds: those of every slice in it and of every slice of an earlier wave, as <interface>.<action>."
                },
                "slices": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["slice", "inHead", "examples"],
                    "properties": {
                      "slice": {
                        "$ref": "proof@1/prove-request.json#/$defs/sliceName"
                      },
                      "inHead": {
                        "type": "boolean",
                        "description": "Whether the slice is in the combined head; the examples of one left out are not tried."
                      },
                      "examples": {
                        "type": "array",
                        "maxItems": 50,
                        "items": {
                          "type": "object"
                        },
                        "description": "The design's worked examples of the slice's actions, as its request carries them."
                      }
                    }
                  },
                  "description": "Each slice of the wave with its examples."
                }
              },
              "description": "The design's worked examples to try on the combined head, slice by slice; left out for a solo proof, which tries none."
            }
          }
        }
      ]
    }
  }
}
