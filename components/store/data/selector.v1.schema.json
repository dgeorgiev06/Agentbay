{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/data/selector/v1",
  "title": "selector/v1",
  "description": "Which items a briefing mode keeps (bay/selector.py). Fields are ANDed, selectors ORed; `not` excludes an item when any of its fields matches. A value may be a list (any value matches). Each source connector declares which fields it handles natively; the store re-applies every selector locally. (No $defs: this schema is inlined into mode config schemas.)",
  "type": "object",
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$"
    },
    "from": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ],
      "description": "Author handle, address, or domain. `*` matches any run of characters (the only wildcard, only in from/to)."
    },
    "to": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ],
      "description": "Recipient address or domain (to/cc). `*` matches any run of characters (the only wildcard, only in from/to)."
    },
    "subject": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ],
      "description": "Substring of the title/subject (case-insensitive; no wildcards)."
    },
    "text": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ],
      "description": "Substring of title or text (case-insensitive; no wildcards)."
    },
    "in": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ],
      "description": "Container: folder, label, list (list:<id>) or channel; `home` is a source's default stream."
    },
    "has": {
      "oneOf": [
        {
          "enum": [
            "link",
            "attachment"
          ]
        },
        {
          "type": "array",
          "items": {
            "enum": [
              "link",
              "attachment"
            ]
          },
          "minItems": 1
        }
      ],
      "description": "link | attachment."
    },
    "since": {
      "type": "string",
      "pattern": "^([0-9]+[mhdw]|[0-9]{4}-.+)$",
      "description": "Relative (7d) or ISO-8601: only items created after it."
    },
    "not": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "from": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "to": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "subject": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "text": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "in": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "has": {
          "oneOf": [
            {
              "enum": [
                "link",
                "attachment"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "link",
                  "attachment"
                ]
              },
              "minItems": 1
            }
          ],
          "description": "link | attachment."
        }
      }
    }
  }
}
