{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digest",
  "description": "The finished digest: themes, each with the stored items it rests on.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "period",
    "selectorChanged",
    "themes",
    "notes",
    "cited"
  ],
  "properties": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "since",
        "until"
      ],
      "description": "The window the digest covers.",
      "properties": {
        "since": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "The start of the window, included."
        },
        "until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "The end of the window, not included."
        }
      }
    },
    "selectorChanged": {
      "type": "boolean",
      "description": "Whether the configured selector differs from the one the store was last synced with; when true, run sync before trusting the digest."
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "sources"
        ],
        "description": "One theme of the digest.",
        "properties": {
          "title": {
            "type": "string",
            "description": "The theme's title."
          },
          "summary": {
            "type": "string",
            "description": "What the items say."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "author",
                "at",
                "url"
              ],
              "description": "One item a theme rests on.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The item's id."
                },
                "author": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Who wrote it."
                },
                "at": {
                  "type": "string",
                  "description": "When it was created."
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Where to open it, or null."
                }
              }
            },
            "description": "The items the theme rests on, as the store holds them."
          }
        }
      },
      "description": "The themes, in the skill's order."
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "The skill's notes, or null."
    },
    "cited": {
      "type": "integer",
      "minimum": 0,
      "description": "How many distinct items the digest cites."
    }
  }
}
