            "O2-C5",
            "O2-C6"
          ],
          "changed": [],
          "removed": []
        }
      ]
    },
    "design": {
      "modules": [
        {
          "name": "todo",
          "hides": "How todos are kept, numbered and never given a removed id again.",
          "implements": ["todo"],
          "owns": {
            "tables": ["todos"]
          },
          "rules": [
            {
              "name": "add-todo",
              "decides": "Whether a text may be added, and the id the new todo gets.",
              "takes": [
                {
                  "name": "request",
                  "schema": {
                    "$ref": "schemas/todo/add-request.json"
                  }
                },
                {
                  "name": "todos",
                  "store": "todos",
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "schemas/todo/add-response.json"
                    }
                  }
                }
              ],
              "gives": [
                {
                  "name": "todos",
                  "store": "todos",
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "schemas/todo/add-response.json"
                    }
                  }
                },
                {
                  "name": "answer",
                  "schema": {
                    "$ref": "schemas/todo/add-response.json"
                  }
                }
              ]
            },
            {
              "name": "mark-done",
              "decides": "Whether a todo may be marked done.",
              "takes": [
                {
                  "name": "request",
                  "schema": {
                    "$ref": "schemas/todo/done-request.json"
                  }
                },
                {
                  "name": "todos",
                  "store": "todos",
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "schemas/todo/add-response.json"
                    }
                  }
                }
              ],
              "gives": [
                {
                  "name": "todos",
                  "store": "todos",
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "schemas/todo/add-response.json"
                    }
                  }
                },
                {
                  "name": "answer",
                  "schema": {
                    "$ref": "schemas/todo/done-response.json"
                  }
                }
              ]
            },
            {
              "name": "remove-todo",
              "decides": "Whether a todo may be removed.",
              "takes": [
                {
                  "name": "request",
                  "schema": {
                    "$ref": "schemas/todo/remove-request.json"
                  }
                },
                {
                  "name": "todos",
                  "store": "todos",
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "schemas/todo/add-response.json"
                    }
                  }
                }
              ],
              "gives": [
                {
                  "name": "todos",
                  "store": "todos",
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "schemas/todo/add-response.json"
                    }
                  }
                },
                {
                  "name": "answer",
                  "schema": {
                    "$ref": "schemas/todo/remove-response.json"
                  }
                }
              ]
            }
          ]
        }
      ],
      "interfaces": [
        {
          "name": "todo",
          "actions": [
            {
              "name": "add",
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              },
              "response": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "text", "status"],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "status": {
                    "enum": ["open", "done"]
                  }
                }
              },
              "serves": ["O1-C1", "O1-C4", "O1-C5", "O1-C6", "O1-C7", "O2-C4"],
              "rule": "add-todo",
              "reads": ["todos"],
              "writes": ["todos"],
              "examples": [
                {
                  "input": {
                    "text": "buy milk"
                  },
                  "answer": {
                    "id": 1,
                    "text": "buy milk",
                    "status": "open"
                  }
                },
                {
                  "earlier": [
                    {
                      "action": "add",
