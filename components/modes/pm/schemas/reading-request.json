{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadingRequest",
  "description": "A reading of the owner's words for a turn, to check against his words.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn",
    "said",
    "reading"
  ],
  "properties": {
    "turn": {
      "$ref": "#/$defs/turn"
    },
    "said": {
      "type": "string",
      "maxLength": 20000
    },
    "reading": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/reading"
      }
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asked",
        "facts"
      ],
      "description": "What the interviewer hands in for one turn. It has no place to settle a question.",
      "properties": {
        "asked": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/asked"
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "asked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "choices",
        "recommended",
        "why"
      ],
      "description": "One question put to the owner in this turn.",
      "properties": {
        "question": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]{0,3}$"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": "The answers offered, lettered a, b and c in this order."
        },
        "recommended": {
          "enum": [
            "a",
            "b",
            "c"
          ],
          "description": "The interviewer's recommended choice."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "One sentence on why it is recommended."
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "says",
        "source",
        "quote"
      ],
      "description": "A fact the interviewer looked up, with the file and the exact words it rests on.",
      "properties": {
        "question": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]{0,3}$"
        },
        "says": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$",
          "description": "The file, relative to the project."
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Words the file holds exactly."
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "takes",
        "words"
      ],
      "description": "What the owner's words say for one question of the turn.",
      "properties": {
        "question": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "description": "The question's number on the turn card."
        },
        "takes": {
          "enum": [
            "choice",
            "own",
            "unsure",
            "pushback"
          ],
          "description": "choice: one of the question's choices; own: his own answer, his words; unsure: he does not know; pushback: he says the question is wrong."
        },
        "letter": {
          "enum": [
            "a",
            "b",
            "c"
          ],
          "description": "The choice, only when takes is choice."
        },
        "words": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "His exact words for this question."
        }
      }
    }
  }
}
