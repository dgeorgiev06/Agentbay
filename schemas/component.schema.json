{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/v4/Component",
  "title": "Component",
  "description": "A component that is not a mode, a connector or a content type (proposal 0010): a folder components/<name>/ holding component.yaml (this file's shape) and whatever it provides by convention (interfaces/, envs/, skills/, data/, tests/). Its name is unique across all components.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "agentbay/v4" },
    "kind": { "const": "Component" },
    "metadata": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*/v[0-9]+$" },
          "description": "Interfaces (name/vN) the component needs."
        }
      }
    }
  }
}
