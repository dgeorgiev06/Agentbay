{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/v4/Component",
  "title": "Component",
  "description": "A component that is not a mode, a connector or a content type (proposal 0010): a shared set: a folder components/base/<name>/ holding component.yaml (this file's shape) and whatever it provides by convention (interfaces/, envs/, skills/, data/, tests/). Its name is unique across all components.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "agentbay/v4" },
    "kind": { "const": "Component" },
    "metadata": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*/v[0-9]+$" },
          "description": "Interfaces (name/vN) the component needs."
        },
        "language": {
          "type": "object",
          "required": ["files", "comments"],
          "additionalProperties": false,
          "description": "A language the standards checkers cover (proposal 0011).",
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^\\*\\.[A-Za-z0-9]+$" },
              "description": "Globs of the form *.<ext>: the files the language's checkers cover."
            },
            "comments": {
              "description": "The comment syntax: python (counted with tokenize) or the line and block markers.",
              "oneOf": [
                { "const": "python" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "line": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "block": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              ]
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["module", "version"],
                "additionalProperties": false,
                "properties": {
                  "module": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                  "version": { "type": "string", "minLength": 1 }
                }
              },
              "description": "Python modules the checkers run with python3 -I -m, at their pinned versions."
            },
            "install": { "type": "string", "description": "What a missing tool tells the user to run." }
          }
        }
      }
    }
  }
}
