                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "serves": ["O2-C3", "O2-C5"],
              "rule": "remove-todo",
              "reads": ["todos"],
              "writes": ["todos"],
              "examples": [
                {
                  "earlier": [
                    {
                      "action": "add",
                      "input": {
                        "text": "buy milk"
                      }
                    },
                    {
                      "action": "add",
                      "input": {
                        "text": "call the bank"
                      }
                    }
                  ],
                  "input": {
                    "id": 2
                  },
                  "answer": {
                    "removed": 2
                  }
                },
                {
                  "earlier": [
                    {
                      "action": "add",
                      "input": {
                        "text": "buy milk"
                      }
                    }
                  ],
                  "input": {
                    "id": 99
                  },
                  "refusal": "No todo has the id 99, so nothing is marked done or removed."
                }
              ]
            }
          ]
