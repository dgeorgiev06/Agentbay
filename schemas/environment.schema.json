{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/v2/Environment",
  "title": "Environment",
  "description": "The container: capability -> connector/tool bindings, secrets (names + provider), network allowlist, filesystem paths, allowed tiers, allowed effects, limits.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agentbay/v2"
    },
    "kind": {
      "const": "Environment"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "bind",
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "bind": {
          "type": "object",
          "description": "<interface>/v<N> -> connector name | [connector names] | {tools, clis, mcpServers}",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "clis": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Narrow command prefixes, compiled to Bash(<prefix>:*)."
                  },
                  "mcpServers": {
                    "type": "object"
                  }
                }
              }
            ]
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "keychain",
                "env"
              ],
              "default": "keychain"
            },
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "fs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "Paths are relative to the project root (the repo the agents work in; for forge that is the agentbay checkout itself). Protected kit paths (framework/, bay/, schemas/) are reachable only when listed explicitly."
        },
        "tiers": {
          "type": "array",
          "items": {
            "enum": [
              "fast",
              "balanced",
              "deep"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Tiers a step in this env may use (default: all). A step whose tier is not listed is a validate error naming the mode, feature, step, role, env and tier."
        },
        "effects": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "write",
              "network",
              "spend",
              "delete"
            ]
          },
          "uniqueItems": true
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxTurns": {
              "type": "integer",
              "minimum": 1
            },
            "maxMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "spendUsd": {
              "type": "number",
              "minimum": 0
            },
            "monthlyItems": {
              "type": "integer",
              "minimum": 0,
              "description": "Items a source may read per UTC month."
            },
            "maxItemsPerRun": {
              "type": "integer",
              "minimum": 0,
              "description": "Items one sync may read."
            }
          }
        },
        "substitutes": {
          "type": "string",
          "description": "This env may stand in for the named env when agentbay.config.yaml selects it with `envs: {<named>: <this>}` (e.g. an offline variant). Bindings still live only in envs/."
        }
      }
    }
  }
}
