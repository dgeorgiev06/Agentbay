{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordRequest",
  "description": "A turn and the owner's answer to each of its cards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "turn",
    "answers",
    "opened"
  ],
  "properties": {
    "job": {
      "type": "string"
    },
    "turn": {
      "type": "object",
      "description": "As schemas/turn.json gives it."
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "As schemas/took.json gives it."
      }
    },
    "opened": {
      "type": "string",
      "minLength": 1,
      "description": "As frontier gave it for this turn."
    }
  }
}
