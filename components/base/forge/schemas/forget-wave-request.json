{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgetWaveRequest",
  "description": "The wave's slices, as wave-begin answered them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["choice", "slices"],
  "properties": {
    "choice": {
      "const": "build"
    },
    "slices": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "proof@1/prove-request.json#/$defs/sliceName"
      }
    }
  }
}
