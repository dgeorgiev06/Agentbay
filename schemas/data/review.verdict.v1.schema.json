{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/data/review.verdict/v1",
  "title": "review.verdict/v1",
  "description": "What a reviewer submits: one verdict per Definition-of-Done item and per reviewer-applicable rule.",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "verdict",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(DOD|R)-[0-9]+$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "n/a"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocker",
              "should-fix",
              "nit"
            ]
          },
          "suggestion": {
            "type": "string"
          },
          "cites": {
            "type": "object",
            "description": "Optional: the run's recorded outcome and to-do numbers (bay plan) this verdict rests on.",
            "additionalProperties": false,
            "properties": {
              "taskId": {
                "type": "string",
                "pattern": "^T-[0-9]{8}-[0-9a-z]{4}$"
              },
              "outcome": {
                "type": "boolean"
              },
              "todo": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
