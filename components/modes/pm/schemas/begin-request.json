{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeginRequest",
  "description": "The owner's choice on the start card, and what the card showed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "choice",
    "opened"
  ],
  "properties": {
    "choice": {
      "type": "string"
    },
    "opened": {
      "type": "object",
      "required": [
        "job",
        "words",
        "namedBy",
        "card"
      ],
      "properties": {
        "job": {
          "$ref": "requirements@1/check-response.json#/$defs/requirements/properties/job"
        },
        "words": {
          "type": "string"
        },
        "namedBy": {
          "type": "string"
        },
        "card": {
          "type": "object"
        }
      },
      "description": "As schemas/opened.json gives it; begin draws the start card again and starts only when it is the same."
    }
  }
}
