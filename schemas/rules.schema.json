{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/v2/Rules",
  "title": "Rules",
  "description": "Two shapes of rules file. kind Rules (the default): modes/<mode>/features/<feature>/rules.yaml; rules stack with mode constraints and role rules, strictest wins; review configuration does NOT belong here (it lives in mode.yaml). kind Conformance: framework/rules/conformance.yaml, the single source of semantic framework rules, read by forge.create/forge.extend reviewers (review.rulesets) and improve.audit; `check` names a deterministic check in bay/conformance.py, and rules without one are judged by the analyst (improve.audit) or reviewer.",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "agentbay/v2" },
    "kind": { "enum": ["Rules", "Conformance"] },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "description": { "type": "string" } }
    },
    "rules": { "type": "array", "minItems": 1 }
  },
  "if": { "required": ["kind"], "properties": { "kind": { "const": "Conformance" } } },
  "then": {
    "required": ["apiVersion", "kind", "rules"],
    "properties": {
      "rules": {
        "items": {
          "type": "object",
          "required": ["id", "level", "statement"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^C-[0-9]+$" },
            "level": { "enum": ["must", "should", "must_not"] },
            "statement": { "type": "string", "minLength": 10 },
            "appliesTo": { "type": "array", "items": { "enum": ["mode", "feature", "role", "agent", "env", "connector", "interface"] }, "uniqueItems": true },
            "check": { "type": "string", "pattern": "^[a-z_]+$" },
            "terms": { "type": "object", "additionalProperties": { "type": "string" }, "description": "vocabulary: retired or synonym term -> the fixed term to use" }
          }
        }
      }
    }
  },
  "else": {
    "not": { "required": ["metadata"] },
    "properties": {
      "kind": { "const": "Rules" },
      "rules": {
        "items": {
          "type": "object",
          "required": ["id", "level", "statement", "appliesTo"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^R-[0-9]+$" },
            "level": { "enum": ["must", "should", "must_not"] },
            "statement": { "type": "string", "minLength": 5 },
            "appliesTo": { "enum": ["executor", "reviewer", "both"] },
            "check": {
              "type": "string",
              "pattern": "^[a-z_]+(:[0-9a-z_]+)?$",
              "description": "Deterministic code check (bay/checks.py), e.g. citations_resolve or citations_min:2."
            },
            "refs": { "type": "array", "items": { "type": "string", "pattern": "^DOD-[0-9]+$" } },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] }
              },
              "description": "Scope the rule to inputs whose `kind` matches (lint checks values against the feature's in-schema enum)."
            }
          }
        }
      }
    }
  }
}
