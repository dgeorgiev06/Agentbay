{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoveResponse",
  "description": "What was removed.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["folder", "kind"],
      "description": "A copy was removed.",
      "properties": {
        "folder": {
          "type": "string",
          "maxLength": 1000,
          "description": "The folder that was removed, relative to the project."
        },
        "kind": {
          "const": "copy",
          "description": "A copy was removed."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["folder", "kind", "branch"],
      "description": "A worktree was removed with its branch.",
      "properties": {
        "folder": {
          "type": "string",
          "maxLength": 1000,
          "description": "The folder that was removed, relative to the project."
        },
        "kind": {
          "const": "worktree",
          "description": "A worktree was removed with its branch."
        },
        "branch": {
          "type": "string",
          "maxLength": 300,
          "description": "The branch that was deleted."
        }
      }
    }
  ]
}
