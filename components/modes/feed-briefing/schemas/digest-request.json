{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DigestRequest",
  "description": "Options for one digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "until": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "The end of the window; now when not given. The window starts the lookback before it."
    },
    "focus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "A topic to put first, such as custody; the digest still covers the window."
    }
  }
}
