{
  "name": "agentbay",
  "version": "5.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config components/base/typescript/eslint.config.js --max-warnings 0 .",
    "format:check": "prettier --config components/base/typescript/prettier.json --check \"**/*.{ts,js}\" package.json tsconfig.json \"components/base/typescript/*.json\"",
    "deadcode": "knip --config components/base/typescript/knip.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deadcode && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
