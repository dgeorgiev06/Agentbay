{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Next",
  "description": "What a run of the interview kept, and the run that comes next, if any.",
  "type": "object",
  "additionalProperties": false,
  "required": ["job", "summary"],
  "properties": {
    "job": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "input"],
      "properties": {
        "workflow": {
          "type": "string"
        },
        "input": {
          "type": "object"
        }
      },
      "description": "The run to start next, for the coordinator."
    }
  }
}
