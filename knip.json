{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "{tests,components/**/tests,adapters/**/tests}/**/*.test.ts",
    "bay/cli.ts!",
    "bay/mcp.ts!",
    "tests/inside/runs/race-driver.ts",
    "bay/sdk.ts!",
    "bay/broker/script-host.ts!",
    "bay/broker/script-preload.ts!",
    "bay/broker/query-child.ts!",
    "bay/broker/database-child.ts!",
    "tests/script-runner-driver.ts",
    "bay/adapter.ts!",
    "components/*/*/scripts/*.ts!",
    "adapters/claude-code/adapter.ts!",
    "adapters/claude-code/step-guard.ts!",
    "schemas/generate-types.ts!"
  ],
  "project": ["{bay,adapters,components,tests,schemas}/**/*.ts!", "!{tests,components/**/tests,adapters/**/tests}/**!"],
  "ignoreIssues": {
    "bay/trust.ts": ["exports"]
  },
  "ignoreExportsUsedInFile": {
    "function": true,
    "type": true
  },
  "eslint": {
    "config": ["components/base/typescript/eslint.config.js"]
  },
  "prettier": {
    "config": ["components/base/typescript/prettier.json"]
  }
}
