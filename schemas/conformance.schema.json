{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/v2/Conformance",
  "title": "Conformance rules",
  "description": "framework/rules/conformance.yaml: the single source of semantic framework rules. Read by forge.create/forge.extend reviewers (review.rulesets) and improve.audit. `check` names a deterministic check in bay/improve/conformance.py; rules without one are judged by the auditor or reviewer.",
  "type": "object",
  "required": ["apiVersion", "kind", "rules"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "agentbay/v2" },
    "kind": { "const": "Conformance" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "description": { "type": "string" } }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "statement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^C-[0-9]+$" },
          "level": { "enum": ["must", "should", "must_not"] },
          "statement": { "type": "string", "minLength": 10 },
          "appliesTo": { "type": "array", "items": { "enum": ["mode", "feature", "role", "agent", "env", "connector", "interface"] }, "uniqueItems": true },
          "check": { "type": "string", "pattern": "^[a-z_]+$" },
          "terms": { "type": "object", "additionalProperties": { "type": "string" }, "description": "vocabulary: retired or synonym term -> the fixed term to use" }
        }
      }
    }
  }
}
