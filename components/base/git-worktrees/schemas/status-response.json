{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StatusResponse",
  "description": "Where a worktree stands.",
  "type": "object",
  "additionalProperties": false,
  "required": ["head", "commits", "clean", "changed", "untracked"],
  "properties": {
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
      "description": "The commit the worktree is at, in full."
    },
    "commits": {
      "type": "array",
      "maxItems": 10000,
      "description": "The commits since the base, oldest first.",
      "items": {
        "description": "One commit.",
        "type": "object",
        "additionalProperties": false,
        "required": ["hash", "subject"],
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
            "description": "The commit's hash, in full."
          },
          "subject": {
            "type": "string",
            "maxLength": 10000,
            "description": "The first line of its message."
          }
        }
      }
    },
    "clean": {
      "type": "boolean",
      "description": "True when no file is changed and none is untracked."
    },
    "changed": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string",
        "maxLength": 4096,
        "description": "A path relative to the worktree."
      },
      "description": "The paths that differ from the worktree's head commit, staged or not."
    },
    "untracked": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string",
        "maxLength": 4096,
        "description": "A path relative to the worktree."
      },
      "description": "The files git does not track and does not ignore."
    }
  }
}
