{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TookRequest",
  "description": "The owner's choice on one card.",
  "type": "object",
  "additionalProperties": false,
  "required": ["choice", "item", "opened"],
  "properties": {
    "choice": {
      "type": "string"
    },
    "item": {
      "type": "object",
      "description": "As schemas/item.json gives it."
    },
    "opened": {
      "type": "string",
      "minLength": 1,
      "description": "As frontier gave it for this turn; a stop is taken only with it."
    }
  }
}
