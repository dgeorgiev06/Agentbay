{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/data/feed.post/v1",
  "title": "feed.post/v1",
  "description": "One post from any feed source. Dedup key is `source:id`.",
  "type": "object",
  "required": ["id", "source", "author", "text", "url", "createdAt", "fetchedAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "author": {
      "type": "object",
      "required": ["handle", "name"],
      "additionalProperties": false,
      "properties": { "handle": { "type": "string" }, "name": { "type": "string" } }
    },
    "text": { "type": "string" },
    "url": { "type": "string", "pattern": "^https://" },
    "createdAt": { "type": "string", "format": "date-time" },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "lang": { "type": "string" },
    "metrics": { "type": "object", "additionalProperties": { "type": "integer" } }
  }
}
