{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StatusResponse",
  "description": "What the store holds for its caller and how each source was last synced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "deletions",
    "sources"
  ],
  "properties": {
    "items": {
      "type": "integer",
      "minimum": 0,
      "description": "Items the store holds for the caller."
    },
    "deletions": {
      "type": "integer",
      "minimum": 0,
      "description": "Ids remembered as deleted."
    },
    "sources": {
      "type": "array",
      "description": "One entry per source that has put items, local included.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "One source.",
        "required": [
          "source",
          "kinds",
          "items",
          "cursor",
          "lastSync",
          "selector",
          "spent"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "maxLength": 64,
            "description": "The source's name."
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A kind."
            },
            "description": "The kinds the source said it produces on its last put."
          },
          "items": {
            "type": "integer",
            "minimum": 0,
            "description": "Items of this source in the store."
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the next sync continues, or null before the first one."
          },
          "lastSync": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the last put from this source finished, an ISO 8601 time, or null."
          },
          "selector": {
            "anyOf": [
              {
                "$ref": "#/$defs/selector"
              },
              {
                "type": "null"
              }
            ],
            "description": "The selector of the last sync, or null when none was given."
          },
          "spent": {
            "type": "array",
            "description": "What fetching from this source cost, per calendar month.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "month",
                "items",
                "usd"
              ],
              "description": "The cost of one month.",
              "properties": {
                "month": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}$",
                  "description": "The month, as YYYY-MM in UTC."
                },
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Items billed in that month."
                },
                "usd": {
                  "type": "number",
                  "minimum": 0,
                  "description": "US dollars spent in that month."
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "description": "Which items a source fetches and the store keeps or returns. Every field given must match; within a list one value is enough. An empty selector matches every item.",
      "additionalProperties": false,
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "An author's handle or address, or a pattern with *."
          },
          "maxItems": 100,
          "uniqueItems": true,
          "description": "Items whose author is one of these, ignoring case and a leading @; * matches any run of characters, so *@example.com matches every address at that domain."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "A label, list, folder or channel name."
          },
          "maxItems": 100,
          "uniqueItems": true,
          "description": "Items that carry at least one of these labels, ignoring case: lists on X, labels and folders in Gmail."
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "A word or phrase to look for."
          },
          "maxItems": 100,
          "uniqueItems": true,
          "description": "Items whose title or text contains at least one of these terms, ignoring case."
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "maxLength": 64,
            "description": "A kind, such as post."
          },
          "maxItems": 20,
          "uniqueItems": true,
          "description": "Items of these kinds only."
        },
        "since": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "Items created at or after this time."
        },
        "until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "Items created before this time."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "The most items one sync fetches over all its pages, or one query returns."
        },
        "native": {
          "type": "object",
          "description": "Fields only the bound source understands, such as a Gmail search string; the source applies them and the store's matcher ignores them."
        }
      }
    }
  }
}
