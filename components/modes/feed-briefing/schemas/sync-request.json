{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyncRequest",
  "description": "Options for one sync.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "since": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Fetch only items created at or after this time; without it, the start of the lookback window before now. A later since in the selector wins."
    }
  }
}
