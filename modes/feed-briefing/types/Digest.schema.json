{
  "type": "object",
  "required": ["period", "themes", "coverage"],
  "additionalProperties": false,
  "properties": {
    "period": {
      "type": "object", "required": ["from", "to"], "additionalProperties": false,
      "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object", "required": ["title", "summary", "citations"], "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 10 },
          "citations": { "type": "array", "items": { "type": "string", "pattern": "^https://" }, "minItems": 1 }
        }
      }
    },
    "coverage": { "$ref": "feed.coverage/v1" },
    "notes": { "type": "string" }
  }
}
