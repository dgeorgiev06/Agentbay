{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnCard",
  "description": "The card of one turn and whether answering it is offered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card",
    "offered"
  ],
  "properties": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "lines",
        "withheld"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mark",
              "words",
              "source"
            ],
            "properties": {
              "mark": {
                "enum": [
                  "computed",
                  "judged"
                ]
              },
              "words": {
                "type": "string"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "step"
                ],
                "properties": {
                  "step": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "withheld": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "offered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answered"
      ],
      "properties": {
        "answered": {
          "type": "boolean"
        }
      }
    }
  }
}
