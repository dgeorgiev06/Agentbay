{
  "name": "agentbay",
  "version": "5.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=$(node -p 'os.availableParallelism() + 1')",
    "test:times": "node tests/suite-times.ts",
    "test:affected": "node tests/affected.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config components/base/typescript/eslint.config.js --max-warnings 0 .",
    "format:check": "prettier --config components/base/typescript/prettier.json --check \"**/*.{ts,js}\" package.json tsconfig.json knip.json \"components/base/typescript/*.json\"",
    "deadcode": "knip --config knip.json --no-config-hints && knip --config knip.json --production",
    "check": "npm run generate:check && npm run typecheck && npm run lint && npm run format:check && npm run deadcode && npm test",
    "generate": "node schemas/generate-types.ts",
    "generate:check": "node schemas/generate-types.ts --check"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
