{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CarryOutWaveResponse",
  "description": "What was done: the combined head merged into into, or every slice's branches kept. Either way forge has forgotten every slice's kept tests.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice", "merged", "into", "slices", "kept"],
      "properties": {
        "choice": {
          "const": "merge"
        },
        "merged": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "into": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)(?!.*//)(?!.*\\.lock$)[A-Za-z0-9_][A-Za-z0-9_./-]*(?<![./])$",
          "maxLength": 255
        },
        "slices": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "proof@1/prove-request.json#/$defs/sliceName"
          }
        },
        "kept": {
          "type": "array",
          "maxItems": 201,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "The branches that stay: those of each slice left out of the combined head."
        },
        "stayed": {
          "type": "array",
          "maxItems": 100,
          "description": "A branch forge asked to drop and worktrees kept, with the reason it gave; left out when every drop went through.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["branch", "reason"],
            "properties": {
              "branch": {
                "type": "string",
                "maxLength": 100,
                "description": "The branch that stayed."
              },
              "reason": {
                "type": "string",
                "maxLength": 2000,
                "description": "worktrees.drop-branch's sentence: why the branch was kept and what would let it go."
              }
            }
          }
        }
      },
      "description": ""
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice", "kept"],
      "properties": {
        "choice": {
          "const": "keep"
        },
        "kept": {
          "type": "array",
          "maxItems": 201,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "The branches that stay: each slice's last builder branch and tests branch, and the combined branch when the card names it."
        },
        "stayed": {
          "type": "array",
          "maxItems": 100,
          "description": "A branch forge asked to drop and worktrees kept, with the reason it gave; left out when every drop went through.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["branch", "reason"],
            "properties": {
              "branch": {
                "type": "string",
                "maxLength": 100,
                "description": "The branch that stayed."
              },
              "reason": {
                "type": "string",
                "maxLength": 2000,
                "description": "worktrees.drop-branch's sentence: why the branch was kept and what would let it go."
              }
            }
          }
        }
      }
    }
  ]
}
