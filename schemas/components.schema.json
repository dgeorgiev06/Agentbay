{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components.schema.json",
  "title": "framework/components.yaml: core components, the paths they own, the contracts they define",
  "type": "object",
  "required": ["components"],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["owns"],
        "additionalProperties": false,
        "properties": {
          "owns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "contracts": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "anyOf": [{ "required": ["at"] }, { "required": ["implements"] }],
              "properties": {
                "at": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "<name>" } },
                "schema": { "type": "string" },
                "tests": { "type": "string" },
                "protocol": { "type": "string" },
                "implements": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*/v[0-9]+$" }
              }
            }
          }
        }
      }
    }
  }
}
