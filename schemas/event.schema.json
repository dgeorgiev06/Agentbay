{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/v2/LedgerEvent",
  "title": "LedgerEvent",
  "description": "One line in .agentbay/ledger/events.jsonl. Append-only. System state is a fold over these events. durationMs, tokens, costUsd, tool, reason and permission.denied are optional: only events that have them carry them.",
  "type": "object",
  "required": [
    "v",
    "ts",
    "type",
    "runId"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "spawned",
        "completed",
        "failed",
        "reclaimed",
        "note",
        "step.started",
        "step.completed",
        "step.failed",
        "step.skipped",
        "agent.plan",
        "agent.plan.done",
        "agent.dispatch",
        "review.recorded",
        "step.planned",
        "call.completed",
        "data.read",
        "permission.denied"
      ]
    },
    "runId": {
      "type": "string",
      "description": "One agent instance or one dispatcher step (<callId>:<step>)."
    },
    "agent": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "source": {
      "enum": [
        "hook",
        "coordinator",
        "cli",
        "dispatcher",
        "guard",
        "plan"
      ]
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "description": "Event-specific detail. note: {kind: note|instruction-change|decision}; call.completed: {status}; review.recorded: {items} of a review.verdict/v1 (runId and taskId name the work reviewed)."
    },
    "mode": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "step": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "env": {
      "type": "string"
    },
    "callId": {
      "type": "string"
    },
    "cost": {
      "type": "object",
      "description": "e.g. {posts, usd}"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall time of the step, call or agent run, when known."
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "Token usage when known.",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0
        },
        "cacheCreation": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "costUsd": {
      "type": "number",
      "minimum": 0,
      "description": "Spend of this step or run in USD, when known."
    },
    "tool": {
      "type": "string",
      "description": "permission.denied: the tool the guard denied (Bash, Read, Edit, ...)."
    },
    "reason": {
      "type": "string",
      "maxLength": 300,
      "description": "permission.denied: why (secret-scanned, truncated)."
    }
  }
}
