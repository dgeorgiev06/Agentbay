          "on": "2026-11-18",
          "run": "none, written by hand from the PM mode design"
        },
        {
          "question": "Is the id of a removed todo given to a new one?",
          "answer": "No, ids are never reused",
          "by": "owner",
          "on": "2026-11-18",
          "run": "none, written by hand from the PM mode design"
        },
        {
          "question": "How long may a todo's text be?",
          "answer": "500 characters",
          "by": "owner",
          "on": "2026-11-18",
          "run": "none, written by hand from the PM mode design"
        }
      ],
