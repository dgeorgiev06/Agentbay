{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/data/improve.finding/v1",
  "title": "improve.finding/v1",
  "description": "One recurring failure, waste or framework drift, with evidence. Stored in .agentbay/data/improve/findings.jsonl, deduplicated by fingerprint (kind + detector key). Secret-scanned before every write.",
  "type": "object",
  "required": [
    "id",
    "fingerprint",
    "lens",
    "kind",
    "title",
    "pattern",
    "evidence",
    "scope",
    "severity",
    "status",
    "priority",
    "history"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^F-[0-9a-f]{8}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "lens": {
      "enum": [
        "sessions",
        "artifacts"
      ]
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "detector name (review-rounds, slow-step, unused, conformance, ...) or `pattern` for analyst findings"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "pattern": {
      "type": "string",
      "maxLength": 600
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "episode",
              "file",
              "measurement",
              "rule",
              "commit"
            ]
          },
          "ref": {
            "type": "string",
            "maxLength": 300,
            "description": "episode id (ab:/cc:/git:), file[:line][#id], rule id, or measurement name"
          },
          "detail": {
            "type": "string",
            "maxLength": 400
          },
          "rewrite": {
            "type": "string",
            "maxLength": 400
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "env": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "framework": {
          "type": "string",
          "description": "framework-level scope (sessions, a tool, a framework file)"
        }
      }
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "severe"
      ]
    },
    "measure": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "costEstimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minutesPerWeek": {
          "type": "number"
        },
        "usdPerWeek": {
          "type": "number"
        },
        "tokensPerWeek": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "rootCause": {
      "type": "string",
      "maxLength": 800
    },
    "proposedFix": {
      "type": "string",
      "maxLength": 800
    },
    "route": {
      "enum": [
        "forge.extend",
        "mode-fix",
        "config",
        "none"
      ]
    },
    "impact": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "effort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "occurrences": {
      "type": "integer",
      "minimum": 1
    },
    "priority": {
      "type": "number",
      "minimum": 0,
      "description": "impact x frequency / effort"
    },
    "status": {
      "enum": [
        "open",
        "approved",
        "deferred",
        "wontfix",
        "in-progress",
        "fixed",
        "verified"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ts",
          "status",
          "by"
        ],
        "additionalProperties": false,
        "properties": {
          "ts": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "detector": {
      "type": "object",
      "required": [
        "name",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "string",
      "description": "scan | audit | analyst"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[0-9a-f]{8}$"
      }
    },
    "firstSeen": {
      "type": "string"
    },
    "lastSeen": {
      "type": "string"
    }
  }
}
