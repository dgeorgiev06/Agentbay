{
  "description": "Analyst/auditor output: findings the detectors did not produce. Each cites evidence that resolves.",
  "type": "object",
  "required": [
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "lens",
          "title",
          "pattern",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "lens": {
            "enum": [
              "sessions",
              "artifacts"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "pattern": {
            "type": "string",
            "maxLength": 600
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "ref"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "episode",
                    "file",
                    "measurement",
                    "rule",
                    "commit"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "detail": {
                  "type": "string",
                  "maxLength": 400
                },
                "rewrite": {
                  "type": "string",
                  "maxLength": 400
                },
                "value": {
                  "type": "number"
                }
              }
            }
          },
          "scope": {
            "type": "object"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "severe"
            ]
          },
          "rootCause": {
            "type": "string",
            "maxLength": 800
          },
          "proposedFix": {
            "type": "string",
            "maxLength": 800
          },
          "rule": {
            "type": "string",
            "pattern": "^C-[0-9]+$"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
