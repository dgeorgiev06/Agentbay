{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SaidRequest",
  "description": "The owner's words for a turn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn",
    "said"
  ],
  "properties": {
    "turn": {
      "$ref": "#/$defs/turn"
    },
    "said": {
      "type": "string",
      "maxLength": 20000,
      "description": "His words, exactly as recorded."
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asked",
        "facts"
      ],
      "description": "What the interviewer hands in for one turn. It has no place to settle a question.",
      "properties": {
        "asked": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/asked"
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "asked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "choices",
        "recommended",
        "why"
      ],
      "description": "One question put to the owner in this turn.",
      "properties": {
        "question": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]{0,3}$"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": "The answers offered, lettered a, b and c in this order."
        },
        "recommended": {
          "enum": [
            "a",
            "b",
            "c"
          ],
          "description": "The interviewer's recommended choice."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "One sentence on why it is recommended."
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "says",
        "source",
        "quote"
      ],
      "description": "A fact the interviewer looked up, with the file and the exact words it rests on.",
      "properties": {
        "question": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]{0,3}$"
        },
        "says": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$",
          "description": "The file, relative to the project."
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Words the file holds exactly."
        }
      }
    }
  }
}
