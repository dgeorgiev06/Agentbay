{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "text",
    "status"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S([\\s\\S]*\\S)?$"
    },
    "status": {
      "enum": [
        "open",
        "done"
      ]
    }
  }
}
