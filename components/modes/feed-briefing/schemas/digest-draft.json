{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DigestDraft",
  "description": "What the digest skill returns; the check holds it to its input and the format script finishes it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "period",
    "selectorChanged",
    "themes",
    "notes"
  ],
  "properties": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "since",
        "until"
      ],
      "description": "The input's period, copied exactly.",
      "properties": {
        "since": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "The start of the window, included."
        },
        "until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "The end of the window, not included."
        }
      }
    },
    "selectorChanged": {
      "type": "boolean",
      "description": "The input's selectorChanged, copied exactly."
    },
    "themes": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "cites"
        ],
        "description": "One theme.",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "description": "A short title, at most the limit's words."
          },
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 800,
            "description": "What the cited items say, in your words, at most the limit's words."
          },
          "cites": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*:\\S",
              "description": "The id of an item the theme rests on, exactly as given."
            },
            "description": "The ids of the given items the theme rests on; at least one, and only ids from the input."
          }
        }
      },
      "description": "The themes, the focus first when one is given; none when the window is empty."
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000,
      "description": "What a reader should know about the digest itself, such as a changed selector or an empty window; null when there is nothing to say."
    }
  }
}
