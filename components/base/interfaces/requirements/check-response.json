{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckResponse",
  "description": "Whether a requirements file is accepted, with what it holds; or every problem with it, each with its line.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "file", "requirements"],
      "description": "The file is in the form and breaks no rule of the check.",
      "properties": {
        "answer": { "const": "accepted" },
        "file": { "type": "string", "maxLength": 1000, "description": "The file checked, as the request named it." },
        "requirements": { "$ref": "#/$defs/requirements" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "file", "problems"],
      "description": "The file could not be read, is not in the form, or breaks a rule of the check.",
      "properties": {
        "answer": { "const": "refused" },
        "file": { "type": "string", "maxLength": 1000, "description": "The file checked, as the request named it." },
        "problems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/problem" },
          "description": "Every problem found at once, by line, first to last."
        }
      }
    }
  ],
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "sentence"],
      "description": "One problem with the file.",
      "properties": {
        "rule": {
          "enum": [
            "file not read",
            "not YAML",
            "not the form",
            "job is not the file's name",
            "no literal in then",
            "no literal in after",
            "vague word",
            "date that moves",
            "no refusal",
            "id used twice",
            "id not its outcome's",
            "removed id used again",
            "changes do not match the version",
            "recommended is not an answer"
          ],
          "description": "The rule the file breaks. not the form is the schema of $defs/requirements; the others are the rules a schema cannot hold. no literal in after is also a refused condition with no after."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "The line of the file the problem is at, counted from 1. Absent only when the file could not be read."
        },
        "sentence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "What is wrong and what to write instead, for a person to act on."
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job",
        "version",
        "title",
        "for",
        "asked",
        "outcomes",
        "leftOut",
        "open",
        "decided",
        "signed",
        "changes"
      ],
      "description": "A requirements file: what a person should see working, as outcomes with conditions, and what is left out.",
      "properties": {
        "job": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100,
          "description": "The job's name, equal to the file's name without .yaml."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "1, then one more at each sign-off."
        },
        "title": { "$ref": "#/$defs/sentence" },
        "for": { "$ref": "#/$defs/sentence" },
        "asked": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/asked" },
          "description": "Each request the file answers, as given."
        },
        "constraints": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/sentence" },
          "description": "What the work must keep to."
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/outcome" },
          "description": "What a person could see working."
        },
        "judged": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/sentence" },
          "description": "Sentences only a person can judge."
        },
        "leftOut": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/sentence" },
          "description": "What is left out on purpose; may be empty."
        },
        "open": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/question" },
          "description": "Questions not yet answered; may be empty."
        },
        "decided": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/decision" },
          "description": "Each question answered, with who answered and when."
        },
        "signed": { "$ref": "#/$defs/by" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/change" },
          "description": "One entry per version: the condition ids it added, changed and removed."
        }
      }
    },
    "sentence": { "type": "string", "minLength": 1, "maxLength": 300, "description": "One sentence." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "A date, YYYY-MM-DD." },
    "name": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Who, or which run." },
    "outcomeId": { "type": "string", "pattern": "^O[1-9][0-9]*$", "description": "O and a number, such as O1." },
    "conditionId": {
      "type": "string",
      "pattern": "^O[1-9][0-9]*-C[1-9][0-9]*$",
      "description": "Its outcome's id, -C and a number, such as O1-C2."
    },
    "conditionIds": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/conditionId" },
      "description": "Condition ids."
    },
    "asked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "on", "words"],
      "description": "One request.",
      "properties": {
        "by": { "$ref": "#/$defs/name" },
        "on": { "$ref": "#/$defs/date" },
        "words": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "The words, as given." }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "says", "conditions"],
      "description": "One outcome a person could see working.",
      "properties": {
        "id": { "$ref": "#/$defs/outcomeId" },
        "says": { "$ref": "#/$defs/sentence" },
        "from": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/name" },
          "description": "Where it came from: asked 1, a section of a document, or a ticket's key."
        },
        "noRefusal": { "$ref": "#/$defs/sentence" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/condition" },
          "description": "What a person does and sees, given, when, then."
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "given", "when", "then"],
      "description": "One thing a person could do and see. A refused one also says what a person sees after.",
      "properties": {
        "id": { "$ref": "#/$defs/conditionId" },
        "path": { "enum": ["works", "refused"], "description": "Whether the person's act works or is refused." },
        "given": { "$ref": "#/$defs/sentence" },
        "when": { "$ref": "#/$defs/sentence" },
        "then": { "$ref": "#/$defs/sentence" },
        "after": { "$ref": "#/$defs/sentence" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asks", "answers", "recommended", "why"],
      "description": "One question not yet answered.",
      "properties": {
        "id": { "type": "string", "pattern": "^Q[1-9][0-9]*$", "description": "Q and a number, such as Q1." },
        "asks": { "$ref": "#/$defs/sentence" },
        "answers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 60, "description": "One answer." },
          "description": "Two or three answers."
        },
        "recommended": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "The answer recommended, counted from 0."
        },
        "why": { "$ref": "#/$defs/sentence" }
      }
    },
    "by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "on", "run"],
      "description": "Who signed, when, and in which run.",
      "properties": {
        "by": { "$ref": "#/$defs/name" },
        "on": { "$ref": "#/$defs/date" },
        "run": { "$ref": "#/$defs/name" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer", "by", "on", "run"],
      "description": "One question answered.",
      "properties": {
        "question": { "$ref": "#/$defs/sentence" },
        "answer": { "type": "string", "minLength": 1, "maxLength": 300, "description": "The answer given." },
        "by": { "$ref": "#/$defs/name" },
        "on": { "$ref": "#/$defs/date" },
        "run": { "$ref": "#/$defs/name" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "on", "added", "changed", "removed"],
      "description": "What one version changed, by condition id.",
      "properties": {
        "version": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "The version." },
        "on": { "$ref": "#/$defs/date" },
        "added": { "$ref": "#/$defs/conditionIds" },
        "changed": { "$ref": "#/$defs/conditionIds" },
        "removed": { "$ref": "#/$defs/conditionIds" }
      }
    }
  }
}
