{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentbay/v2/Rules",
  "title": "Feature rules",
  "description": "modes/<mode>/features/<feature>/rules.yaml. Rules stack with mode constraints and role rules; strictest wins. Review configuration does NOT belong here (it lives in mode.yaml).",
  "type": "object",
  "required": [
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agentbay/v2"
    },
    "kind": {
      "const": "Rules"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "statement",
          "appliesTo"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[0-9]+$"
          },
          "level": {
            "enum": [
              "must",
              "should",
              "must_not"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 5
          },
          "appliesTo": {
            "enum": [
              "executor",
              "reviewer",
              "both"
            ]
          },
          "check": {
            "type": "string",
            "pattern": "^[a-z_]+(:[0-9a-z_]+)?$",
            "description": "Deterministic code check (bay/checks.py), e.g. citations_resolve or citations_min:2."
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^DOD-[0-9]+$"
            }
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ]
              }
            },
            "description": "Scope the rule to inputs whose `kind` matches (lint checks values against the feature's in-schema enum)."
          }
        }
      }
    }
  }
}
