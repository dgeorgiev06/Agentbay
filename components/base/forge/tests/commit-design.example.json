            {
              "name": "done",
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "response": {
                "$ref": "add-response.json"
              },
              "serves": ["O2-C1", "O2-C2", "O2-C5", "O2-C6"],
              "rule": "mark-done",
              "reads": ["todos"],
              "writes": ["todos"],
              "examples": [
                {
                  "earlier": [
                    {
                      "action": "add",
                      "input": {
                        "text": "buy milk"
                      }
                    }
                  ],
                  "input": {
                    "id": 1
                  },
                  "answer": {
                    "id": 1,
                    "text": "buy milk",
                    "status": "done"
                  }
                },
                {
                  "earlier": [
                    {
                      "action": "add",
                      "input": {
                        "text": "buy milk"
                      }
                    },
                    {
                      "action": "done",
                      "input": {
                        "id": 1
                      }
                    }
                  ],
                  "input": {
                    "id": 1
                  },
                  "refusal": "Todo 1 is already done, so it is not marked again."
                },
                {
                  "earlier": [
                    {
                      "action": "add",
                      "input": {
                        "text": "buy milk"
